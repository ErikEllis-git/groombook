# Copy to .env.local for local development.

# Postgres connection. Locally: the Docker container from the README.
# On Vercel, the Neon integration sets DATABASE_URL (pooled) and
# DATABASE_URL_UNPOOLED (direct, used for migrations) automatically.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/groombook

# Dashboard login. Generate the secret with: openssl rand -base64 48
SESSION_SECRET=
DASHBOARD_PASSWORD=

# Phone push alerts via https://ntfy.sh (free, no account).
# Pick a long, hard-to-guess topic name and subscribe to it in the ntfy app.
NTFY_TOPIC=
# NTFY_SERVER=https://ntfy.sh

# Optional email alerts via Resend (https://resend.com, free tier).
# RESEND_API_KEY=
# NOTIFY_EMAIL=kevin@example.com
# NOTIFY_EMAIL_FROM="GroomBook <onboarding@resend.dev>"

# Optional display settings.
# NEXT_PUBLIC_BUSINESS_NAME="Kevin's Mobile Dog Grooming"
# NEXT_PUBLIC_OWNER_NAME=Kevin
# BUSINESS_TIMEZONE=America/New_York
# SITE_URL=https://your-deployment.vercel.app
